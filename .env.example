# Copy to .env.local and fill in (Supabase → Project Settings → API Keys).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "publishable" key (sb_publishable_…) or the legacy "anon" key. It is safe to be public –
# row level security in supabase/schema.sql decides what each user may do.
VITE_SUPABASE_KEY=

# Only needed for `npm run db:apply` (Supabase → Connect → Session pooler). Never exposed to the app.
SUPABASE_DB_URL=
